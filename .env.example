# 이 파일은 GitHub에 올라갑니다 (API 키 없이 형식만 보여줌)
# 실제 키는 .env.local 파일에 넣고 사용하세요 (.env.local은 .gitignore로 업로드되지 않음)

# 네이버 개발자센터(https://developers.naver.com/apps/#/register) - "검색" API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Anthropic(https://console.anthropic.com) - Claude API
ANTHROPIC_API_KEY=

# OpenWeatherMap(https://openweathermap.org/api) - 날씨 API
WEATHER_API_KEY=
